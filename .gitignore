# Fichiers auxiliaires LaTeX
*.aux
*.log
*.out
*.toc
*.xdv
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.bbl
*.blg
# tableaux et listings écrits par la librairie pendant la compilation
*.tab
*.listing

# PDF produits par la compilation (make les régénère)
*.pdf
# ... sauf les documents sources des fiches
!UVM/AED_SV_UVM_Cheatsheet_20250919.pdf
!Verilog/VERILOG-CHEATSHEET-.pdf
# ... et la version release, publiée par GitHub Actions (tag v*)
!pdf/*.pdf

# Aperçus et brouillons, rendus de l'audit (régénérés par le skill audit-fiche)
apercu*.png
audit/**/*.png

# Éditeurs et système
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
